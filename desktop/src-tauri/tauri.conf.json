{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Director Studio",
  "version": "0.1.0",
  "identifier": "studio.ai-director.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Director Studio",
        "width": 1680,
        "height": 940,
        "minWidth": 1280,
        "minHeight": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
